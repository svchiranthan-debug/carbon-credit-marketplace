# Backend API base URL for the Expo app (must include /api).
# Physical phone: use your computer's LAN IP, e.g. http://192.168.1.20:8000/api
# If unset, the app uses the IP of the machine running Metro, then 10.0.2.2 (Android emulator) or localhost.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8000/api
