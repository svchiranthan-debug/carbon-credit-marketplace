# Copy to backend/.env and adjust. Every value has a development default; see app/config.py.

# Leave unset: a random key is generated into this file on first start.
# SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (default: SQLite file backend/carbon_marketplace.db)
# DATABASE_URL=sqlite:////absolute/path/to/carbon_marketplace.db

# Where uploaded ground photos are stored (default: backend/uploads)
# UPLOAD_DIR=/absolute/path/to/uploads

# Comma-separated browser origins allowed to call the API, or * for any (default *)
# CORS_ORIGINS=http://localhost:5174,http://localhost:8081

# Satellite NDVI (Microsoft Planetary Computer, no key needed for low volume)
ENABLE_REAL_SATELLITE_QUERIES=true
# PLANETARY_COMPUTER_API_KEY=
# SATELLITE_LOOKBACK_DAYS=120
# SATELLITE_MAX_SCENE_CLOUD_PCT=20
# SATELLITE_MAX_ATTEMPTS=3

# Local blockchain (Ganache). Set ENABLE_BLOCKCHAIN=false to skip on-chain recording.
ENABLE_BLOCKCHAIN=true
ETHEREUM_RPC_URL=http://127.0.0.1:8545
